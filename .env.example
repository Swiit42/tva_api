# Copier ce fichier en ".env" (non versionné) avant de lancer docker compose.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=tva
POSTGRES_PORT=5435

# Utilisé par les scripts Python (chargement, rapport, API) pour se
# connecter à la même base que celle démarrée par docker-compose.
DATABASE_URL=postgresql://meridian:meridian@localhost:5435/tva
